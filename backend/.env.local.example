# ==========================================================================
# قالب التشغيل المحلي — انسخه إلى .env.local ثم شغّل key:generate
#
#     cp .env.local.example .env.local
#     php artisan key:generate --env=local
#
# ⚠ لماذا .env.local لا .env؟
#   خادم التطوير يُشغَّل بـ APP_ENV=local، ولارافيل عندها يقرأ .env.local
#   ويتجاهل .env تمامًا. فأي إعداد تضعه في .env لن يراه الموقع المحلي.
#
# ⚠ ولماذا لا يكفي .env.example؟
#   ذاك مضبوط على الإنتاج: MySQL و APP_DEBUG=false. وبلا أي ملف بيئة
#   يسقط لارافيل على إعداده الافتراضي — PostgreSQL على المنفذ 5432 —
#   فتظهر رسالة عن قاعدة اسمها ptc_hub لا علاقة لها بالمشروع.
# ==========================================================================

APP_NAME="PTC Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ar

FRONTEND_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:8000

# قاعدة ملفّية — لا تحتاج تثبيت أي خادم قواعد بيانات.
# الملف يُنشأ تلقائيًا عند أول php artisan migrate.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ==========================================================================
# البريد — اختياري محليًّا
#
# اتركه log فلا يُرسَل شيء، وتُكتب الرسالة في storage/logs/laravel.log.
# يكفي لتجربة «نسيت كلمة السر» و«تواصل معنا» بلا حساب Brevo ولا إنترنت.
#
# ولو أردت إرسالًا حقيقيًّا: MAIL_MAILER=brevo مع مفتاح صالح.
# ⚠ وعلى ويندوز يحتاج ذلك حزمة شهادات في php.ini وإلا سقط بـcURL error 60
#   — والمخرج أبسط: اترك MAIL_MAILER=log محليًّا كما هو أعلاه.
# ==========================================================================
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.test
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================================================
# حساب المدير المحلي — يُنشأ مرة واحدة عند php artisan db:seed
#
# ⚠ الاسم بين علامتي اقتباس إلزامًا: فيه مسافة، ودotenv يرفض القيمة غير
#   المقتبسة ويُسقط الملف كله فيتعطّل كل أمر وكل صفحة.
# ==========================================================================
ADMIN_NAME="مدير محلي"
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=Local!Admin123
