# ─────────────────────────────────────────────────────────────
#  PTC Hub — قالب الإعداد
#
#  انسخه إلى .env على الخادم واملأ القيم:
#      cp .env.example .env
#      php artisan key:generate
#
#  ⚠ .env لا يُرفع إلى git أبدًا، ولا يُوضع داخل ptc-hub-frontend
#    (ذلك المجلد هو جذر النشر، وكل ما فيه يصير قابلًا للتحميل).
# ─────────────────────────────────────────────────────────────

APP_NAME="PTC Hub"

# production على الخادم. local للتطوير فقط.
APP_ENV=production

# يولّده php artisan key:generate — لا تتركه فارغًا ولا تنسخه من مشروع آخر.
APP_KEY=

# ⚠ false على الخادم دائمًا. true يعرض مسارات الملفات وقيم الإعدادات
#   لأي زائر عند أول خطأ.
APP_DEBUG=false

APP_URL=https://example.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

# ─────────────────── الواجهة ───────────────────
# الواجهة والـAPI على النطاق نفسه، لكن CORS يحتاجهما صراحةً.
FRONTEND_URL=https://example.com
FRONTEND_ORIGINS=https://example.com

# ─────────────────── قاعدة البيانات ───────────────────
# mysql على الاستضافة المشتركة · sqlite محليًا · pgsql إن انتقلت لـNeon.
# تحقّقت الهجرات على MySQL فعليًا قبل التسليم: 17 هجرة و24 جدولًا utf8mb4.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ─────────────────── الجلسات والطابور ───────────────────
# الاستضافة المشتركة بلا queue worker: sync يعني التنفيذ داخل الطلب.
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync

# ─────────────────── البريد (Brevo) ───────────────────
# البريد يُرسَل عبر واجهة Brevo على HTTPS لا عبر SMTP: الطابور sync
# أعلاه يعني أن الإرسال داخل دورة الطلب، وكثير من الاستضافات المشتركة
# تسكّر المنفذين ٥٨٧ و٢٥ صادرًا — فيصير الطلب معلَّقًا أمام الطالب لا
# رسالةً متأخرة. المنفذ ٤٤٣ لا يُسكَّر.
#
# ⚠ BREVO_API_KEY مفتاح من Brevo › SMTP & API › API Keys، ويبدأ بـ
#   xkeysib-. إن تسرّب فاحذفه من لوحتهم وولّد غيره.
# ⚠ MAIL_FROM_ADDRESS لا بد أن يكون مُرسِلًا موثَّقًا في Brevo
#   (Senders & IP › Senders) وإلا رُفضت كل رسالة — الخطوات في تسليم-المشروع.md.
MAIL_MAILER=brevo
BREVO_API_KEY=
BREVO_TIMEOUT=10
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# صندوق استفسارات «تواصل معنا». اتركه فارغًا لتصل الاستفسارات إلى
# MAIL_FROM_ADDRESS نفسه، واملأه لتحويلها لبريد آخر. وهو مستقلّ عن
# المُرسِل لأن المُرسِل وحده هو ما يشترط Brevo توثيقه — أما المستقبِل فأي
# بريد. ورسائل النموذج تحمل بريد الطالب في Reply-To فالردّ يصله مباشرة.
CONTACT_INBOX_ADDRESS=

# للتطوير المحلي بلا حساب: MAIL_MAILER=log يكتب الرسالة كاملة في
# storage/logs/laravel.log بدل إرسالها، ورابط إعادة التعيين يُقرأ منها.

# ─────────────────── الملفات ───────────────────
# المشروع لا يخزّن بايتات أي ملف — كل المحتوى روابط خارجية.
# هذه الإعدادات تخصّ مسار الرفع المعطّل، وتُترك كما هي.
FILESYSTEM_DISK=local
FILE_MAX_SIZE_MB=2048
FILE_UPLOAD_URL_MINUTES=10
FILE_DOWNLOAD_URL_MINUTES=10

# سقف حجم بلوب تقدّم الطالب المحفوظ في قاعدة البيانات.
PROGRESS_MAX_KB=512

# ─────────────────── حدود المعدّل ───────────────────
# طلبات في الدقيقة. القيم هي الافتراضية، تُذكر هنا للعلم بها.
API_RATE_LIMIT_GUEST=60
API_RATE_LIMIT_USER=120
AUTH_RATE_LIMIT_IP=20
AUTH_RATE_LIMIT_EMAIL=5
AUTH_RATE_LIMIT_PASSWORD_CHANGE=6

# صلاحية توكن الدخول بالدقائق (أسبوعان). null تعني صلاحية أبدية —
# واختبار في المشروع يسقط إن صارت كذلك.
SANCTUM_EXPIRATION_MINUTES=20160

# ─────────────────── حساب المدير الأول ───────────────────
# يقرأها AdminSeeder مرة واحدة عند php artisan db:seed.
# ⚠ غيّر كلمة المرور من داخل الموقع بعد أول دخول، ثم احذف
#   السطر من .env — لا داعي لبقائها على الخادم.
# ⚠ الاسم بين علامتي اقتباس إلزامًا. AdminSeeder يقسّمه على المسافات إلى
#   اسم أول واسم أب واسم عائلة، أي أن المسافات مقصودة — وdotenv يرفض أي
#   قيمة غير مقتبسة فيها مسافة ويُسقط الملف كله:
#       The environment file is invalid!
#   وعندها يتعطّل **كل** أمر artisan وكل صفحة في الموقع، لا البذرة وحدها.
ADMIN_NAME="PTC Hub Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─────────────────── بوت تيليجرام (تجريبي، مرحلة ١) ───────────────────
# TELEGRAM_BOT_TOKEN من @BotFather. TELEGRAM_BOT_USERNAME بدون @ (مثل
# PTCHubTestBot). TELEGRAM_WEBHOOK_SECRET أي نص عشوائي طويل تخترعه أنت
# بنفسك (مو من تيليجرام) — تستخدمه لاحقًا بأمر setWebhook نفسه، وهو ما
# يمنع أي طرف غير تيليجرام من مناداة /telegram/webhook مباشرة.
# منفصل بالكامل عن TELEGRAM_CONTRIBUTIONS_* (بوت المساهمة بالمحتوى).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ─────────────────── السجلّات ───────────────────
LOG_CHANNEL=stack
LOG_LEVEL=error
